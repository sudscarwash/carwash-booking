# ==============================================================================
# CAR WASH BOOKING SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your keys to run in production or local development.
# Never commit the actual '.env' file containing secrets to version control.

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"                      # Options: development, production, test
PORT=3000                                 # Server port to bind to (Default: 3000)
SESSION_SECRET="your-super-secret-random-cookie-key"  # Used to sign session/auth cookies
JWT_SECRET="generate-a-long-random-string-for-jwt-signing"  # Required for signing JWT tokens securely in production
APP_URL="https://your-carwash-app.com"     # Deployed public URL for routing and mail templates

# ------------------------------------------------------------------------------
# STAGING / TEST TESTING CONTROLS (RENDER DEV ENVIRONMENT)
# ------------------------------------------------------------------------------
# Set to "true" on Render if you want to show the interactive multi-role quick login switcher
# (Customer, Owner, Employee, Special User, Admin) for testing even in compiled builds.
# Set to "false" or leave blank on Google Cloud Run (Production).
VITE_ENABLE_DEV_ROLE_SWITCHER="true"

# ------------------------------------------------------------------------------
# GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Required if you activate intelligent AI features (e.g. smart scheduling suggestions, review parsing)
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# DATABASE CONNECTIONS (SUPABASE / POSTGRESQL / RENDER / CLOUD RUN)
# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL (RECOMMENDED FOR PERMANENT PRODUCTION PERSISTENCE):
# Serverless platforms like Google Cloud Run and Render restart their containers.
# To keep all accounts, bookings, services, and closures permanently, connect to Supabase:
#
# IMPORTANT FOR HOSTED PLATFORMS (Cloud Run, Render, AWS, Vercel):
# Use the CONNECTION POOLER on PORT 6543 (Session mode or Transaction mode) with IPv4:
# DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Optional DIRECT_URL for direct migration connection:
# DIRECT_URL="postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""

# Supabase direct API integration (Optional, if using Supabase Auth or Client-Side SDK)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-never-share-this"

# ------------------------------------------------------------------------------
# EMAIL DELIVERY SERVICES (Gmail Workspace SMTP vs Resend API)
# ------------------------------------------------------------------------------
# Choose active provider: 'GMAIL_SMTP' or 'RESEND'
EMAIL_PROVIDER="GMAIL_SMTP"

# SENDER ADDRESS & DISPLAY NAME:
# Uses the alias you configured in Gmail (Gear -> Settings -> Accounts -> "Send mail as")
EMAIL_FROM_ADDRESS="AutoshineBN <info@domain.com>"
EMAIL_REPLY_TO="info@domain.com"
EMAIL_SUPPORT_ADDRESS="support@domain.com"

# --- OPTION A: Google Workspace / Gmail SMTP (500 free emails/day) ---
# GMAIL_USER: The primary Google Workspace account you login with (e.g. admin@domain.com)
GMAIL_USER="admin@domain.com"
# GMAIL_APP_PASSWORD: The 16-character Google App Password (REQUIRED by Google for SMTP).
# Generate this at: https://myaccount.google.com/apppasswords
# (Note: Google Account -> Security -> 2-Step Verification must be ON)
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# --- OPTION B: Resend API (100 free emails/day) ---
# If using Resend instead of Gmail SMTP, uncomment:
# RESEND_API_KEY="re_123456789abcdefghijklmnopqrstuv"

# ------------------------------------------------------------------------------
# CLOUDINARY IMAGE STORAGE
# ------------------------------------------------------------------------------
# Used for storing car wash showcase images, vehicle condition photos, and staff avatars
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# AWS CLOUD ENVIRONMENT (S3 Backup / Deployment alternative)
# ------------------------------------------------------------------------------
# If you prefer Amazon S3 over Cloudinary for storing photos, or for system backups
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-southeast-1"               # Singapore/Brunei region is ap-southeast-1
AWS_S3_BUCKET_NAME="your-carwash-production-bucket"
