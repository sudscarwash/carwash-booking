# ==============================================================================
# CAR WASH BOOKING SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your keys to run in production or local development.
# Never commit the actual '.env' file containing secrets to version control.

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"                      # Options: development, production, test
PORT=3000                                 # Server port to bind to (Default: 3000)
SESSION_SECRET="your-super-secret-random-cookie-key"  # Used to sign session/auth cookies
JWT_SECRET="generate-a-long-random-string-for-jwt-signing"  # Required for signing JWT tokens securely in production
APP_URL="https://your-carwash-app.com"     # Deployed public URL for routing and mail templates

# ------------------------------------------------------------------------------
# GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Required if you activate intelligent AI features (e.g. smart scheduling suggestions, review parsing)
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# DATABASE CONNECTIONS
# ------------------------------------------------------------------------------
# 1. SQLite Option (Default / Local / Zero-Config)
# Leave blank or exclude DATABASE_URL to continue using local SQLite (data/carwash.db)
# 
# 2. PostgreSQL / Supabase Option
# Provide a standard PostgreSQL connection string to transition to a scalable cloud DB
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require"

# Supabase direct API integration (Optional, if using Supabase Auth or Client-Side SDK)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-never-share-this"

# ------------------------------------------------------------------------------
# EMAIL DELIVERY SERVICES (Resend)
# ------------------------------------------------------------------------------
# Used for booking confirmations, cancellation alerts, and staff scheduling emails
RESEND_API_KEY="re_123456789abcdefghijklmnopqrstuv"
EMAIL_FROM_ADDRESS="no-reply@your-carwash-domain.com"
EMAIL_SUPPORT_ADDRESS="support@your-carwash-domain.com"

# ------------------------------------------------------------------------------
# CLOUDINARY IMAGE STORAGE
# ------------------------------------------------------------------------------
# Used for storing car wash showcase images, vehicle condition photos, and staff avatars
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# AWS CLOUD ENVIRONMENT (S3 Backup / Deployment alternative)
# ------------------------------------------------------------------------------
# If you prefer Amazon S3 over Cloudinary for storing photos, or for system backups
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-southeast-1"               # Singapore/Brunei region is ap-southeast-1
AWS_S3_BUCKET_NAME="your-carwash-production-bucket"
